{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server:app",
      "functions": {
        "server.py": {
          "maxDuration": 30
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "redirects": [
    { "source": "/limitations-and-solutions", "destination": "/#/limitations-and-solutions", "permanent": false },
    { "source": "/e/:token", "destination": "/#/e/:token", "permanent": false },
    { "source": "/j/:token", "destination": "/#/j/:token", "permanent": false },
    { "source": "/j/:token/register", "destination": "/#/j/:token/register", "permanent": false },
    { "source": "/j/:token/sign-in", "destination": "/#/j/:token/sign-in", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
